---
interface Props {
  accent?: 'azure' | 'scarlet' | 'tangerine' | 'gold' | 'neutral';
}

const { accent = 'neutral' } = Astro.props;
---

<span class:list={['tag', `tag--${accent}`]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) 10px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tag--neutral { background: var(--neutral); color: var(--muted); }
  .tag--azure { background: var(--azure-tint); color: var(--azure-ink); }
  .tag--scarlet { background: var(--scarlet-tint); color: var(--scarlet-ink); }
  .tag--tangerine { background: var(--tangerine-tint); color: var(--tangerine-ink); }
  .tag--gold { background: var(--gold-tint); color: var(--gold-ink); }
</style>
