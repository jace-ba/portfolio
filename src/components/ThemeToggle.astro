---
import IsoButton from './IsoButton.astro';
import Icon from './Icon.astro';
---

<IsoButton size="icon" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
  <Icon name="moon" class="icon-moon" />
  <Icon name="sun" class="icon-sun" />
</IsoButton>

<style>
  /* Both glyphs share one cell and crossfade, so the swap doesn't pop. */
  :global(.theme-toggle .iso-btn.iso-btn--icon) {
    display: grid;
    place-items: center;
  }
  :global(.theme-toggle svg) {
    grid-area: 1 / 1;
    transition: opacity var(--dur-flood-fade) ease;
  }
  :global(html.flooding .theme-toggle svg) {
    transition: opacity var(--dur-flood-fade) ease;
  }
  :global(:root[data-theme="dark"] .theme-toggle .icon-moon),
  :global(:root:not([data-theme="dark"]) .theme-toggle .icon-sun) {
    opacity: 0;
  }
</style>

<script>
  import { endFlood, floodTo } from '../scripts/theme-flood';

  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  // This module runs once. The header toggle stays in the document; a toggle
  // inside a swapped page is a new element and still needs a listener.
  const bound = new WeakSet<HTMLElement>();

  const readStored = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  function apply(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    const next = theme === 'dark' ? 'light' : 'dark';
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((t) => {
      t.setAttribute('aria-label', `Switch to ${next} theme`);
    });
  }

  function bindToggles() {
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((t) => {
      if (bound.has(t)) return;
      bound.add(t);
      t.addEventListener('click', () => {
        floodTo(t, (next) => {
          apply(next);
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
      });
    });
  }

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
  bindToggles();

  media.addEventListener('change', (e) => {
    if (!readStored()) apply(e.matches ? 'dark' : 'light');
  });

  // ClientRouter replaces <html> attributes with the incoming page's, which
  // carries no data-theme; hand the current one over before the swap.
  document.addEventListener('astro:before-swap', (e) => {
    endFlood();
    e.newDocument.documentElement.dataset.theme = root.dataset.theme;
  });

  document.addEventListener('astro:page-load', () => {
    apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
    bindToggles();
  });
</script>
