---
interface Props {
  year?: number;
  ongoing?: boolean;
}

const { year, ongoing = false } = Astro.props;
const yearLabel = year == null ? undefined : ongoing ? `${year}–now` : String(year);
---

{yearLabel && <p class="year">{yearLabel}</p>}

<style>
  .year {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
</style>
