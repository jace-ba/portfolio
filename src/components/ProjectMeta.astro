---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';

interface Props {
  year?: number;
  ongoing?: boolean;
  category: string;
  stack: string;
  accent: CollectionEntry<'projects'>['data']['accent'];
}

const { year, ongoing = false, category, stack, accent } = Astro.props;
const yearLabel = year == null ? undefined : ongoing ? `${year}–now` : String(year);
---

<div class="meta">
  {yearLabel && <p class="year">{yearLabel}</p>}
  <span class="tags">
    <Tag accent={accent}>{category}</Tag>
    <Tag>{stack}</Tag>
  </span>
</div>

<style>
  .meta {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .year {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
