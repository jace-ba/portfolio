} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const filled = name === "linkedin" || name === "handshake";
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? undefined : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width={filled ? undefined : "2"}
  stroke-linecap={filled ? undefined : "round"}
  stroke-linejoin={filled ? undefined : "round"}
  aria-hidden="true"
  set:html={paths[name]}
/>
