  handshake:
    '<rect width="24" height="24" rx="5.18" fill="#D3FB52"/><path fill="#052326" transform="scale(0.145455)" d="M99.5856 33.1611L92.95 70.9048L73.4585 86.8363L82.8902 33.1611H63.9964L46.521 132.161H65.4147L70.2673 104.772L89.8297 88.719L82.1101 132.161H101.014L118.479 33.1611H99.5856Z"/>',
