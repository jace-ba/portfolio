---
/* Card preview. An isometric tile until a project has a thumbnail. */
interface Props {
  accent: 'azure' | 'scarlet' | 'tangerine' | 'gold';
  size?: 'card' | 'hero' | 'portrait';
  class?: string;
  /** Three blank squares in the nav colors, on the page background. */
  nav?: boolean;
}

const { accent, size = 'card', class: className, nav = false } = Astro.props;
const navColors = ['scarlet', 'tangerine', 'gold'] as const;
---

<div
  class:list={['thumb', `thumb--${size}`, className, { 'thumb--image': Astro.slots.has('default'), 'thumb--nav': nav }]}
  style={`--thumb-bg: var(--${accent}-tint); --tile: var(--${accent}); --tile-edge: var(--${accent}-edge);`}
  aria-hidden="true"
>
  {
    nav ? (
      <div class="nav-row">
        {navColors.map((color) => (
          <div class="tile tile--square" style={`--tile: var(--${color}); --tile-edge: var(--${color}-edge)`} />
        ))}
      </div>
    ) : Astro.slots.has('default') ? (
      <slot />
    ) : (
      <div class="tile" />
    )
  }
</div>

<style>
  .thumb {
    display: grid;
    place-items: center;
    background: var(--thumb-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  /* A transparent file would otherwise show the accent wash behind the tile. */
  .thumb--image {
    place-items: stretch;
    background: var(--neutral-tint);
  }
  /* min-size: auto would keep the file's own aspect ratio, and the frame
     would clip the overflow from the bottom or the right. */
  .thumb--image :global(img) {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: cover;
    object-position: center;
  }
  .thumb.thumb--nav {
    background: var(--bg);
  }
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    width: 100%;
    padding-inline: var(--space-3);
  }
  .tile.tile--square {
    flex: 1 1 0;
    width: auto;
    max-width: 88px;
    min-width: 0;
    height: auto;
    aspect-ratio: 1;
  }
  .thumb--card { height: 188px; }
  .thumb--hero { height: clamp(220px, 32vw, 360px); border-radius: var(--radius-xl); }
  .thumb--portrait { aspect-ratio: 6 / 7; border-radius: var(--radius-xl); }

  .tile {
    --depth: var(--iso-depth);
    width: 104px;
    height: 64px;
    border-radius: var(--radius-md);
    background: var(--tile);
    box-shadow: 0 var(--depth) 0 0 var(--tile-edge);
    transition: transform var(--dur-release) var(--ease-spring), box-shadow var(--dur-release) var(--ease-spring);
  }
  /* Face color eases on its own animation. The shadow cannot run on the
     compositor, and its geometry shares this ease with hover. */
  :global(html.flooding) .tile {
    transition:
      transform var(--dur-release) var(--ease-spring),
      box-shadow var(--dur-flood-fade) ease;
  }
  .thumb--hero .tile,
  .thumb--portrait .tile {
    --depth: 12px;
    width: 150px;
    height: 96px;
    border-radius: var(--radius-lg);
  }

  /* the tile half-presses when its card is hovered, echoing the buttons */
  :global(a:hover) > .thumb .tile,
  :global(a:focus-visible) > .thumb .tile {
    transform: translateY(calc(var(--depth) * 0.35));
    box-shadow: 0 calc(var(--depth) * 0.65) 0 0 var(--tile-edge);
  }
</style>
