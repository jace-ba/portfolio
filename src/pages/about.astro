---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import GeometryPuzzle from '../components/GeometryPuzzle.astro';
import QuoteOfTheWeek from '../components/QuoteOfTheWeek.astro';
import pinballCannon from '../assets/pinball-cannon.jpg';
import profilePhoto from '../assets/profile-photo.jpg';

const openTo = [
  { label: 'Roles', value: 'Systems, ML and computer vision, simulation, software engineering' },
  { label: 'Timing', value: 'Spring or summer 2027 internships; full-time from June 2028' },
  { label: 'Location', value: 'Seattle; open to remote and relocation' },
];
---

<BaseLayout
  title="About"
  description="Jace Baptista-Allan is a Computer Science and Physics student at the University of Washington, applying computation to physical and real-world problems."
>
  <div class="page">
    <section class="bio-row">
      <Image
        src={profilePhoto}
        alt="Jace with Dubs, the University of Washington husky mascot"
        widths={[360, 720]}
        sizes="(max-width: 800px) 100vw, 360px"
        class="portrait"
        loading="eager"
      />
      <div class="intro">
        <h1>Jace Baptista-Allan</h1>
        <p class="role">
          Computer Science and Physics student at the University of Washington.
        </p>
        <p class="lede">
          Born and raised in Seattle, I build VR physics simulations at UW. I build to understand, then
          build so others can understand too.
        </p>
      </div>
    </section>

    <section class="section origin" aria-labelledby="origin">
      <h2 id="origin">Why computer science and physics?</h2>
      <div class="copy">
          <p>
            I fell in love with both a long time ago, during a middle
            school science fair project. Armed with an Arduino, servo motors, and a spring from a pinball machine,
            I constructed a pinball cannon and programmed a trajectory solver
            that adjusted the cannon's angle to shoot the pinball a target
            distance. Despite my improvised materials, it actually worked.
          </p>
          <p>
            Physics asks you what’s true underneath a system, and computer science lets you turn that
            model into something other people can use. During my time tutoring physics and building labs
            for VR, I’ve seen how much the right tool changes what people can grasp.
          </p>
      </div>
      <Image
        src={pinballCannon}
        alt="Jace in seventh grade holding the pinball cannon in front of his science-fair poster"
        widths={[360, 720]}
        sizes="(max-width: 800px) min(100vw, 360px), 360px"
        class="cannon"
      />
    </section>

    <section class="section" aria-labelledby="work">
      <h2 id="work">How I work</h2>
      <div class="copy">
        <p>
          I prefer being spec-first. When working in teams or with AI agents, I always start with the
          requirements and get everyone on the same page before anything gets built.
        </p>
        <p>
          At NOMR, I focus on mathematical accuracy and on designing open-ended labs that let users set
          up their own experiment without following a deterministic lesson plan. Each week I
          consolidate research, meet with an expert, and set goals for the next sprint. I derive every
          formula on paper before it gets solidified into the code.
        </p>
      </div>
      <div class="now">
        <p class="eyebrow">Right now</p>
        <h3>Software developer, Novel Observations in Mixed Reality</h3>
        <p class="org">UW Department of Physics</p>
        <a href="/projects/vr-physics-labs">See the VR physics labs</a>
      </div>
    </section>

    <section class="section" aria-labelledby="outside">
      <h2 id="outside">Outside the lab</h2>
      <div class="copy">
        <p>
          I’ve played drums since I was 7, and I’ve been making 3D animations since 7th grade (fun fact:
          when I was 14, I made a video intro for PewDiePie and he used it!). I also like building
          custom keyboards. Right now, I’m working on machining a keyboard case out of some walnut wood.
        </p>
        <p>
          I also love making geometry puzzles. This was one of my favorites to make. See if you can
          solve it!
        </p>
      </div>
      <GeometryPuzzle />
      <a href="/projects#smaller-builds">Smaller things I’ve built</a>
    </section>

    <QuoteOfTheWeek />

    <section class="panel contact" aria-labelledby="contact">
      <h2 id="contact">Contact</h2>
      <dl class="facts">
        {
          openTo.map(({ label, value }) => (
            <div class="fact">
              <dt class="eyebrow">{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <ContactLinks />
    </section>
  </div>
</BaseLayout>

<style>
  .bio-row {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .bio-row :global(.portrait) {
    width: 100%;
    height: auto;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    border-radius: var(--radius-xl);
  }

  .role {
    font-size: var(--text-lg);
    max-width: 28em;
  }

  .copy {
    display: grid;
    gap: var(--space-4);
    max-width: 65ch;
  }

  .origin {
    grid-template-columns: minmax(0, 1fr) min(360px, 42%);
    column-gap: var(--space-7);
  }

  .origin h2,
  .origin .copy {
    grid-column: 1;
  }

  .origin :global(.cannon) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
  }

  .now {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    max-width: 42em;
  }

  .now h3 {
    font-size: var(--text-lg);
  }

  .org {
    color: var(--muted);
  }

  .contact {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding: var(--space-7);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4) var(--space-6);
    width: 100%;
    margin: 0;
  }

  .fact {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .fact dd {
    margin: 0;
  }

  @media (max-width: 800px) {
    .bio-row {
      grid-template-columns: 1fr;
    }
    .bio-row :global(.portrait) {
      max-width: 360px;
    }
    .origin {
      grid-template-columns: 1fr;
    }
    .origin :global(.cannon) {
      grid-column: 1;
      grid-row: auto;
      max-width: 360px;
    }
  }

  @media (max-width: 600px) {
    .contact {
      padding: var(--space-6);
    }
  }
</style>
