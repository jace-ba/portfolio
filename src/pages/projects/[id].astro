---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IsoButton from '../../components/IsoButton.astro';
import IsoTile from '../../components/IsoTile.astro';
import Icon from '../../components/Icon.astro';
import Tag from '../../components/Tag.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getMainProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getMainProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, summary, category, stack, accent, year } = project.data;
const { Content } = await render(project);
const hasWriteUp = !!project.body?.trim();
---

<BaseLayout title={title} description={summary}>
  <article class="page">
    <div>
      <IsoButton href="/projects">
        <Icon name="arrowLeft" />
        All projects
      </IsoButton>
    </div>

    <header class="intro">
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <div class="tags">
        <Tag accent={accent}>{category}</Tag>
        <Tag>{stack}</Tag>
        {year != null && <Tag>{year}</Tag>}
      </div>
    </header>

    <IsoTile accent={accent} size="hero" />

    <div class="prose">
      {hasWriteUp ? <Content /> : <Placeholder label="Write-up" />}
    </div>

    {
      next.id !== project.id && (
        <nav class="project-nav" aria-label="More projects">
          <IsoButton href={`/projects/${prev.id}`}>
            <Icon name="arrowLeft" />
            Previous project
          </IsoButton>
          <IsoButton href={`/projects/${next.id}`}>
            Next project
            <Icon name="arrowRight" />
          </IsoButton>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }
  /* Stays on the right when the pair wraps onto two rows. */
  .project-nav > :global(:last-child) {
    margin-left: auto;
  }

  .prose {
    max-width: 68ch;
    display: grid;
    gap: var(--space-4);
  }
  .prose :global(h2) {
    margin-top: var(--space-5);
  }
  .prose :global(ul) {
    margin: 0;
    padding-left: 1.25em;
    display: grid;
    gap: var(--space-2);
  }
  .prose :global(blockquote) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    color: var(--muted);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--surface-sunken);
    font-size: 0.9em;
  }
</style>
