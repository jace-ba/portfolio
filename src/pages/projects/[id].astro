---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IsoButton from '../../components/IsoButton.astro';
import Icon from '../../components/Icon.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import StyleSheet from '../../components/StyleSheet.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  const lists = {
    project: projects.filter((project) => project.data.kind === 'project'),
    small: projects.filter((project) => project.data.kind === 'small'),
  };
  return projects.map((project) => {
    const list = lists[project.data.kind];
    const i = list.findIndex((item) => item.id === project.id);
    return {
      params: { id: project.id },
      props: {
        project,
        prev: list[(i - 1 + list.length) % list.length],
        next: list[(i + 1) % list.length],
      },
    };
  });
}

const { project, prev, next } = Astro.props;
const { title, summary, year, ongoing, documents } = project.data;
const { Content } = await render(project);
const hasWriteUp = !!project.body?.trim();
const filled = hasWriteUp || documents?.some((doc) => doc.preview) === true;
---

<BaseLayout title={title} description={summary}>
  <article class="page">
    <div>
      <IsoButton href="/projects">
        <Icon name="arrowLeft" />
        All projects
      </IsoButton>
    </div>

    <header class="intro">
      <div class="heading">
        <h1>{title}</h1>
        <ProjectMeta year={year} ongoing={ongoing} />
      </div>
      <p class="lede">{summary}</p>
      {
        documents && documents.length > 0 && (
          <div class="documents">
            {documents.map((doc) => (
              <div class="document">
                {doc.preview && (
                  <a class="preview" href={doc.href} target="_blank" rel="noopener noreferrer">
                    <img
                      src={doc.preview.src}
                      alt={doc.preview.alt}
                      width={doc.preview.width}
                      height={doc.preview.height}
                    />
                    <span class="preview-mark">
                      <Icon name="external" size={20} />
                    </span>
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
                {doc.caption && (
                  <a class="caption" href={doc.href} target="_blank" rel="noopener noreferrer">
                    {doc.caption}
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
                {doc.label && (
                  <IsoButton href={doc.href} variant={doc.variant} target="_blank" rel="noopener noreferrer">
                    {doc.label}
                    <Icon name="external" />
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </IsoButton>
                )}
              </div>
            ))}
          </div>
        )
      }
    </header>

    {project.id === 'this-portfolio' && <StyleSheet />}
    {
      hasWriteUp && (
        <div class="prose">
          <Content />
        </div>
      )
    }
    {!filled && <p class="unfinished">This page isn't finished yet! More info is coming soon.</p>}

    {
      next.id !== project.id && (
        <nav class="project-nav" aria-label="More projects">
          <IsoButton href={`/projects/${prev.id}`}>
            <Icon name="arrowLeft" />
            Previous project
          </IsoButton>
          <IsoButton href={`/projects/${next.id}`}>
            Next project
            <Icon name="arrowRight" />
          </IsoButton>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .heading {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .documents {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  .document {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  /* One picture would otherwise stretch across the whole page. */
  .document:only-child {
    max-width: 36rem;
  }

  .preview {
    --preview-dim: 0.08;
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface);
    line-height: 0;
  }
  :global(:root[data-theme='dark']) .preview {
    --preview-dim: 0.16;
  }

  .preview img {
    width: 100%;
    height: auto;
  }

  .preview-mark {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    display: grid;
    place-items: center;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    pointer-events: none;
  }

  /* Darkens the picture on hover and stays there while the pointer is down. */
  .preview::after {
    content: '';
    position: absolute;
    z-index: 0;
    inset: 0;
    background: black;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-release) var(--ease-press);
  }
  .preview:active::after,
  .preview:focus-visible::after {
    opacity: var(--preview-dim);
  }
  @media (hover: hover) {
    .preview:hover::after {
      opacity: var(--preview-dim);
    }
  }

  .caption {
    max-width: 68ch;
    color: var(--link);
    text-underline-offset: 0.2em;
  }

  .project-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }
  /* Stays on the right when the pair wraps onto two rows. */
  .project-nav > :global(:last-child) {
    margin-left: auto;
  }

  .unfinished {
    max-width: 68ch;
    color: var(--muted);
  }

  .prose {
    max-width: 68ch;
    display: grid;
    gap: var(--space-4);
  }
  .prose :global(h2) {
    margin-top: var(--space-5);
  }
  .prose :global(ul) {
    margin: 0;
    padding-left: 1.25em;
    display: grid;
    gap: var(--space-2);
  }
  .prose :global(blockquote) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    color: var(--muted);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--surface-sunken);
    font-size: 0.9em;
  }
</style>
