---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IsoButton from '../../components/IsoButton.astro';
import IsoTile from '../../components/IsoTile.astro';
import Icon from '../../components/Icon.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getMainProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getMainProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, summary, category, stack, accent, year, ongoing, documents } = project.data;
const { Content } = await render(project);
const hasWriteUp = !!project.body?.trim();
const filled = hasWriteUp || (documents?.length ?? 0) > 0;
---

<BaseLayout title={title} description={summary}>
  <article class="page">
    <div>
      <IsoButton href="/projects">
        <Icon name="arrowLeft" />
        All projects
      </IsoButton>
    </div>

    <header class="intro">
      <div class="heading">
        <h1>{title}</h1>
        <ProjectMeta year={year} ongoing={ongoing} category={category} stack={stack} accent={accent} />
      </div>
      <p class="lede">{summary}</p>
      {
        documents && documents.length > 0 && (
          <div class="documents">
            {documents.map((doc) => (
              <div class="document">
                {doc.preview && (
                  <a class="preview" href={doc.href} target="_blank" rel="noopener noreferrer">
                    <img
                      src={doc.preview.src}
                      alt={doc.preview.alt}
                      width={doc.preview.width}
                      height={doc.preview.height}
                    />
                    <span class="visually-hidden">(opens in a new tab)</span>
                  </a>
                )}
                <IsoButton href={doc.href} target="_blank" rel="noopener noreferrer">
                  {doc.label}
                  <Icon name="external" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </IsoButton>
              </div>
            ))}
          </div>
        )
      }
    </header>

    {!filled && <IsoTile accent={accent} size="hero" />}

    {
      hasWriteUp ? (
        <div class="prose">
          <Content />
        </div>
      ) : (
        !filled && (
          <div class="prose">
            <Placeholder label="Write-up" />
          </div>
        )
      )
    }

    {
      next.id !== project.id && (
        <nav class="project-nav" aria-label="More projects">
          <IsoButton href={`/projects/${prev.id}`}>
            <Icon name="arrowLeft" />
            Previous project
          </IsoButton>
          <IsoButton href={`/projects/${next.id}`}>
            Next project
            <Icon name="arrowRight" />
          </IsoButton>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .heading {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .documents {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    align-items: start;
  }

  .document {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .preview {
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    line-height: 0;
  }

  .preview img {
    width: 100%;
    height: auto;
  }

  .project-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }
  /* Stays on the right when the pair wraps onto two rows. */
  .project-nav > :global(:last-child) {
    margin-left: auto;
  }

  .prose {
    max-width: 68ch;
    display: grid;
    gap: var(--space-4);
  }
  .prose :global(h2) {
    margin-top: var(--space-5);
  }
  .prose :global(ul) {
    margin: 0;
    padding-left: 1.25em;
    display: grid;
    gap: var(--space-2);
  }
  .prose :global(blockquote) {
    margin: 0;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    color: var(--muted);
  }
  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--surface-sunken);
    font-size: 0.9em;
  }
</style>
