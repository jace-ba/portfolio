---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getMainProjects } from '../lib/projects';

const featured = (await getMainProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout>
  <div class="page">
    <section class="intro hero">
      <h1>Jace Baptista-Allan</h1>
      <p class="lede">Open to spring and summer 2027 internships</p>
    </section>

    <section class="section" aria-labelledby="selected">
      <div class="section-head">
        <h2 id="selected">Selected projects</h2>
        <a href="/projects">All projects</a>
      </div>
      <div class="card-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero h1 {
    max-width: 15em;
  }
</style>
