---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsoButton from '../components/IsoButton.astro';
import IsoTile from '../components/IsoTile.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="About" description="About Jace Baptista-Allan.">
  <div class="page">
    <section class="bio-row">
      <IsoTile accent="azure" size="portrait" class="portrait" />
      <div class="intro">
        <p class="eyebrow">About</p>
        <h1>Jace Baptista-Allan</h1>
      </div>
    </section>

    <section class="section" aria-labelledby="skills">
      <h2 id="skills">What I work with</h2>
      <div class="skills"></div>
    </section>

    <section class="section experience" aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <ol class="jobs"></ol>
    </section>

    <section class="panel contact" aria-labelledby="contact">
      <h2 id="contact">Contact</h2>
      <div class="button-row">
        <IsoButton href="mailto:jacedba@gmail.com" variant="azure">
          <Icon name="mail" />
          Email me
        </IsoButton>
        <IsoButton href="/resume.pdf" download>
          <Icon name="download" />
          Download résumé
        </IsoButton>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .bio-row {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .experience {
    gap: var(--space-3);
  }

  .jobs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jobs li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .jobs h3 {
    margin-bottom: var(--space-1);
  }
  .jobs p,
  .when {
    color: var(--muted);
  }
  .when {
    font-size: var(--text-sm);
    padding-top: 0.2em;
  }

  .contact {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-7);
  }

  @media (max-width: 800px) {
    .bio-row {
      grid-template-columns: 1fr;
    }
    .bio-row :global(.portrait) {
      max-width: 360px;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .jobs li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .contact {
      padding: var(--space-6);
    }
  }
</style>
