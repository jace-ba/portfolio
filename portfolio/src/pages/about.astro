---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsoButton from '../components/IsoButton.astro';
import IsoTile from '../components/IsoTile.astro';
import Icon from '../components/Icon.astro';
import Tag from '../components/Tag.astro';

const skills = [
  { title: 'Design', accent: 'orange', items: ['Figma', 'Prototyping', 'Design systems'] },
  { title: 'Code', accent: 'blue', items: ['Astro', 'TypeScript', 'CSS', 'Accessibility'] },
  { title: 'Craft', accent: 'green', items: ['Motion', 'Illustration', 'Writing'] },
] as const;

const jobs = [
  { when: '2025 – now', role: 'Freelance designer & developer', what: 'Portfolio sites and design systems for small studios.' },
  { when: '2023 – 2025', role: 'Front-end developer, Example Co.', what: 'Built the component library and led the accessibility pass.' },
  { when: '2021 – 2023', role: 'Design intern, Sample Studio', what: 'Prototyped interactions and shipped marketing pages.' },
];
---

<BaseLayout title="About" description="About Jace: a designer who codes.">
  <div class="page">
    <section class="bio-row">
      <IsoTile accent="orange" size="portrait" class="portrait" />
      <div class="intro">
        <p class="eyebrow">About</p>
        <h1>Hello again.</h1>
        <p class="lede">
          I’m Jace, a designer who codes. I like interfaces that feel physical: things that press, tilt, and spring back.
        </p>
        <p>
          Most of my work sits between design and front-end: I sketch in Figma, then finish the details in the browser,
          where motion and states are real. Outside of work I draw, hike, and keep too many plants.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="skills">
      <h2 id="skills">What I work with</h2>
      <div class="skills">
        {
          skills.map((group) => (
            <div class="skill-group">
              <h3>{group.title}</h3>
              <div class="tags">
                {group.items.map((item) => <Tag accent={group.accent}>{item}</Tag>)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section experience" aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <ol class="jobs">
        {
          jobs.map((job) => (
            <li>
              <span class="when">{job.when}</span>
              <div>
                <h3>{job.role}</h3>
                <p>{job.what}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="panel contact" aria-labelledby="contact">
      <h2 id="contact">Let’s make something together.</h2>
      <p class="lede">I’m open to freelance projects and full-time roles.</p>
      <div class="button-row">
        <IsoButton href="mailto:hello@example.com" variant="orange">
          <Icon name="mail" />
          Email me
        </IsoButton>
        <IsoButton href="/resume.pdf" download>
          <Icon name="download" />
          Download résumé
        </IsoButton>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .bio-row {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-3);
  }

  .skill-group {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .experience {
    gap: var(--space-3);
  }

  .jobs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jobs li {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .jobs h3 {
    margin-bottom: var(--space-1);
  }
  .jobs p,
  .when {
    color: var(--muted);
  }
  .when {
    font-size: var(--text-sm);
    padding-top: 0.2em;
  }

  .contact {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-7);
  }

  @media (max-width: 800px) {
    .bio-row {
      grid-template-columns: 1fr;
    }
    .bio-row :global(.portrait) {
      max-width: 360px;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .jobs li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .contact {
      padding: var(--space-6);
    }
  }
</style>
