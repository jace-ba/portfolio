---
import BaseLayout from '../layouts/BaseLayout.astro';
import IsoButton from '../components/IsoButton.astro';
import IsoTile from '../components/IsoTile.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
---

<BaseLayout
  title="About"
  description="Jace Baptista-Allan is a Computer Science and Physics student at the University of Washington, applying computation to physical and real-world problems."
>
  <div class="page">
    <section class="bio-row">
      <IsoTile accent="azure" size="portrait" class="portrait" />
      <div class="intro">
        <p class="eyebrow">About</p>
        <h1>Jace Baptista-Allan</h1>
        <p class="role">
          Computer Science and Physics student at the University of Washington, applying computation to
          physical and real-world problems.
        </p>
        <Placeholder label="Personal intro" />
      </div>
    </section>

    <section class="section" aria-labelledby="now">
      <h2 id="now">Right now</h2>
      <div class="now">
        <h3>Software developer, Novel Observations in Mixed Reality</h3>
        <p class="org">UW Department of Physics</p>
        <p>
          Building interactive VR physics simulations in C# and Unity for undergraduate laboratories.
          The software is used in introductory and advanced physics courses at UW and WSU.
        </p>
      </div>
    </section>

    <section class="panel contact" aria-labelledby="contact">
      <h2 id="contact">Contact</h2>
      <div class="button-row">
        <IsoButton href="mailto:jacedba@gmail.com" variant="azure">
          <Icon name="mail" />
          Email me
        </IsoButton>
        <IsoButton href="https://www.linkedin.com/in/jacedba/" target="_blank" rel="noopener noreferrer">
          <Icon name="external" />
          LinkedIn
        </IsoButton>
        <IsoButton href="/resume.pdf" download>
          <Icon name="download" />
          Download résumé
        </IsoButton>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .bio-row {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .role {
    font-size: var(--text-lg);
    max-width: 28em;
  }

  .now {
    display: grid;
    gap: var(--space-2);
    max-width: 42em;
  }

  .now h3 {
    font-size: var(--text-lg);
  }

  .org {
    color: var(--muted);
  }

  .contact {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-7);
  }

  @media (max-width: 800px) {
    .bio-row {
      grid-template-columns: 1fr;
    }
    .bio-row :global(.portrait) {
      max-width: 360px;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .contact {
      padding: var(--space-6);
    }
  }
</style>
