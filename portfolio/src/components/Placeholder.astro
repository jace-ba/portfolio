---
/** An empty gap waiting on copy that isn't in the résumé. No invented text. */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="placeholder">Placeholder: {label}</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 4.5rem;
    padding: var(--space-4);
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
