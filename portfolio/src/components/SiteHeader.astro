---
import IsoButton from './IsoButton.astro';
import Icon from './Icon.astro';
import SiteNav from './SiteNav.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<div class="container header-wrap" transition:persist="site-header" transition:animate="none">
  <header class="site-header">
    <div class="bar" data-flood-host>
      <div class="bar-fill" data-flood-base></div>
    </div>
    <a class="brand" href="/" data-flood-host>
      <span class="brand-given">Jace</span>
      <span class="brand-family">Baptista-Allan</span>
    </a>
    <SiteNav />
    <div class="actions">
      <IsoButton
        href="/resume.pdf"
        size="pill"
        target="_blank"
        rel="noopener noreferrer"
        class="resume-link"
      >
        RÉSUMÉ
        <Icon name="external" />
        <span class="visually-hidden">(opens in a new tab)</span>
      </IsoButton>
      <ThemeToggle />
    </div>
  </header>
</div>

<style>
  .header-wrap {
    padding-top: var(--space-5);
  }

  .site-header {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-5);
    padding: var(--space-5);
  }

  /* The painted cell. The splash punches the old fill out of the wave, so a
     covered corner is only the new color. Buttons stay outside it and keep tilting. */
  .bar {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    pointer-events: none;
  }

  .bar-fill {
    position: absolute;
    inset: -2px;
    background: var(--surface);
  }

  .site-header :global(.site-nav) {
    position: relative;
    z-index: 1;
    justify-self: center;
  }

  .brand {
    position: relative;
    z-index: 1;
    justify-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1;
  }

  .brand-given {
    font-size: 62.5px;
    line-height: 0.88;
  }

  .brand-family {
    font-size: 19px;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Beats .brand { position: relative } so the splash copy overlays the name. */
  .brand[data-flood-clone] {
    position: absolute;
    inset: 0;
  }

  .actions {
    position: relative;
    z-index: 1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 860px) {
    .site-header {
      --iso-square-size: 72px;
      grid-template-columns: 1fr auto;
      row-gap: var(--space-4);
      padding: var(--space-4);
    }
    .bar {
      border-radius: var(--radius-lg);
    }
    .actions {
      grid-column: 2;
      grid-row: 1;
    }
    .site-header :global(.site-nav) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* The pill is wider than the square it replaced, so pull the row in
     until the name, résumé, and theme toggle fit side by side. */
  @media (max-width: 560px) {
    .site-header {
      --pill-pad-inline: 0.85rem;
      column-gap: var(--space-3);
      padding: var(--space-3);
    }
    .brand {
      padding-inline: 0;
    }
    .actions {
      gap: var(--space-2);
    }
  }

  @media (max-width: 480px) {
    .brand-given {
      font-size: 40px;
    }
    .brand-family {
      font-size: 13px;
    }
  }
</style>
