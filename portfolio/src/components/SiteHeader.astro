---
import IsoButton from './IsoButton.astro';
import Icon from './Icon.astro';
import SiteNav from './SiteNav.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<div class="container header-wrap" transition:persist="site-header" transition:animate="none">
  <header class="site-header">
    <a class="brand" href="/">
      <span class="brand-given">Jace</span>
      <span class="brand-family">Baptista-Allan</span>
    </a>
    <SiteNav />
    <div class="actions">
      <IsoButton href="/resume.pdf" download size="square">
        <Icon name="download" />
        Resume
      </IsoButton>
      <ThemeToggle />
    </div>
  </header>
</div>

<style>
  .header-wrap {
    padding-top: var(--space-5);
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--space-5);
    padding: var(--space-5);
    background: var(--surface);
    border-radius: var(--radius-xl);
  }

  .site-header :global(.site-nav) {
    justify-self: center;
  }

  .brand {
    justify-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1;
  }

  .brand-given {
    font-size: 62.5px;
    line-height: 0.88;
  }

  .brand-family {
    font-size: 19px;
    line-height: 1.2;
    white-space: nowrap;
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 860px) {
    .site-header {
      --iso-square-size: 72px;
      grid-template-columns: 1fr auto;
      row-gap: var(--space-4);
      padding: var(--space-4);
      border-radius: var(--radius-lg);
    }
    .actions {
      grid-column: 2;
      grid-row: 1;
    }
    .site-header :global(.site-nav) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (max-width: 480px) {
    .brand-given {
      font-size: 40px;
    }
    .brand-family {
      font-size: 13px;
    }
  }
</style>
