---
import IsoButton from './IsoButton.astro';
import Icon from './Icon.astro';
import SiteNav from './SiteNav.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<div class="header-sticky" transition:persist="site-header" transition:animate="none">
  <!-- Page color behind the bar, including the gutters, so content scrolling
       under the pinned header stays hidden. Its bottom stops where the bar's
       corner curve starts, so content stays visible in the cutouts until it
       passes under the bar. Sliced with the theme splash. -->
  <div class="header-scrim" data-flood-host aria-hidden="true"></div>
  <div class="container header-wrap">
    <header class="site-header">
      <div class="bar">
        <div class="bar-fill" data-flood-host></div>
      </div>
      <a class="brand" href="/" data-flood-host>
        <span class="brand-given">Jace</span>
        <span class="brand-family">Baptista-Allan</span>
      </a>
      <SiteNav />
      <div class="actions">
        <IsoButton
          href="/resume.pdf"
          size="pill"
          target="_blank"
          rel="noopener noreferrer"
          class="resume-link"
        >
          RÉSUMÉ
          <Icon name="external" />
          <span class="visually-hidden">(opens in a new tab)</span>
        </IsoButton>
        <ThemeToggle />
      </div>
    </header>
  </div>
</div>

<script>
  // Two-row layouts only: hide the nav row while scrolling down, show it on the way back up.
  const sticky = document.querySelector<HTMLElement>('.header-sticky');
  const nav = sticky?.querySelector<HTMLElement>('.site-nav');
  // Must match the two-row media query in the styles below.
  const twoRow = matchMedia('(max-width: 842px)');
  const THRESHOLD = 8;

  if (sticky && nav) {
    let anchor = scrollY;
    let frame = 0;

    const setHidden = (hidden: boolean) => sticky.toggleAttribute('data-nav-hidden', hidden);

    const update = () => {
      frame = 0;
      const y = scrollY;
      const hidden = sticky.hasAttribute('data-nav-hidden');
      if (!twoRow.matches || y < sticky.offsetHeight || sticky.querySelector(':focus-visible')) {
        setHidden(false);
        anchor = y;
      } else if (y - anchor > THRESHOLD) {
        setHidden(true);
        anchor = y;
      } else if (anchor - y > THRESHOLD) {
        setHidden(false);
        anchor = y;
      } else if (hidden ? y > anchor : y < anchor) {
        // Track the turning point, so the threshold counts from where the direction changed.
        anchor = y;
      }
    };

    const showNav = () => {
      setHidden(false);
      anchor = scrollY;
    };

    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    // Entering the two-row layout shows the nav. The bar growing taller can
    // nudge the scroll position, so show it again once that settles.
    twoRow.addEventListener('change', () => {
      showNav();
      requestAnimationFrame(showNav);
    });
    // Keyboard focus only: a tap focuses the button on some browsers.
    sticky.addEventListener('focusin', (e) => {
      if ((e.target as Element).matches(':focus-visible')) setHidden(false);
    });
    document.addEventListener('astro:after-swap', () => {
      setHidden(false);
      anchor = scrollY;
    });

    new ResizeObserver(() => {
      sticky.style.setProperty('--nav-row-h', `${nav.offsetHeight}px`);
    }).observe(nav);
  }
</script>

<style>
  .header-sticky {
    --bar-radius: var(--radius-xl);
    /* How far the bar's bottom edge rises while the nav row is hidden. */
    --nav-collapse: 0px;
    position: sticky;
    top: 0;
    /* viewport-fit=cover draws the page under the notch and Dynamic Island.
       The scrim covers this band; the bar starts below it. */
    padding-top: env(safe-area-inset-top, 0px);
    /* Above the page. The skip link sits at 10. */
    z-index: 5;
  }

  /* Background stays on the class so the splash copy, which drops
     data-flood-host, still paints. The attribute selector only wins
     position: [data-flood-host] would otherwise drop this into the flow
     as an empty box. */
  .header-scrim {
    background: var(--bg);
    pointer-events: none;
  }

  .header-scrim[data-flood-host] {
    position: absolute;
    inset: 0 0 calc(var(--bar-radius) + var(--nav-collapse)) 0;
    z-index: 0;
    transition: bottom var(--dur-release) var(--ease-press);
  }

  .header-wrap {
    position: relative;
    z-index: 1;
    container-type: inline-size;
    padding-top: var(--space-5);
  }

  .site-header {
    --hdr-gap: var(--space-5);
    /* The nav dot centers itself in this band, under the seated button. */
    --hdr-pad-block: var(--space-5);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--hdr-gap);
    padding: var(--hdr-pad-block);
  }

  /* The painted cell. Buttons stay outside it and keep tilting. */
  .bar {
    position: absolute;
    inset: 0 0 var(--nav-collapse) 0;
    transition: bottom var(--dur-release) var(--ease-press);
    z-index: 0;
    overflow: hidden;
    border-radius: var(--bar-radius);
    pointer-events: none;
  }

  /* The fill and its splash copies must share one compositor layer. Rounded
     separately, the old color shows through the new one's antialiased corners.
     The overscan keeps their own edges, which can land mid-pixel, outside the clip. */
  .bar > .bar-fill {
    position: absolute;
    inset: -2px;
    will-change: transform;
  }

  .bar-fill {
    background: var(--surface);
  }

  .site-header :global(.site-nav) {
    position: relative;
    z-index: 1;
    justify-self: center;
    transition:
      opacity var(--dur-release) var(--ease-press),
      transform var(--dur-release) var(--ease-press),
      visibility 0s linear 0s;
  }

  .brand {
    --brand-pad: 12px;
    --brand-size: 19px;
    position: relative;
    z-index: 1;
    justify-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: var(--brand-pad);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    line-height: 1;
  }

  .brand-given {
    font-size: calc(var(--brand-size) * 62.5 / 19);
    line-height: 0.88;
  }

  .brand-family {
    font-size: var(--brand-size);
    line-height: 1.2;
    white-space: nowrap;
  }

  /* Beats .brand { position: relative } so the splash copy overlays the name. */
  .brand[data-flood-clone] {
    position: absolute;
    inset: 0;
  }

  .actions {
    position: relative;
    z-index: 1;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Still the wide single row: same padding, same gaps, nav on the center
     of the bar. The name shrinks once the résumé and theme buttons have used
     up the space on the right and start pushing the nav left. The two-row
     query below takes over at 842px, one pixel under a half-screen window
     (843px viewport on a 2560×1600 display at 150%). */
  @media (max-width: 949px) {
    .site-header {
      /* Measured full-size widths of the nav and of the résumé and theme
         group; update them if those labels change. */
      --nav-w: 329px;
      --actions-w: 228px;
    }
    /* "BAPTISTA-ALLAN" is about 8.84em wide. The floor sits under the size
       this formula yields at 843px, so the name keeps shrinking through the
       whole one-row range and the bar padding does not give way. */
    .brand {
      --brand-size: clamp(
        13px,
        (100cqi - 2 * var(--space-5) - 2 * var(--hdr-gap) - var(--nav-w) - var(--actions-w) - 2 * var(--brand-pad)) / 8.84,
        19px
      );
    }
  }

  /* Narrower than a half-screen window, the nav drops to its own row. The
     name and the résumé/theme pair stay a centered group instead of
     stretching to opposite ends of the bar. The nav row hides while scrolling
     down. */
  @media (max-width: 842px) {
    .header-sticky {
      --bar-radius: var(--radius-lg);
      --hdr-row-gap: var(--space-3);
    }
    .header-wrap {
      padding-top: var(--space-3);
    }
    .site-header {
      --hdr-gap: var(--space-5);
      --hdr-pad-block: var(--space-4);
      grid-template-columns: auto auto;
      justify-content: center;
      row-gap: var(--hdr-row-gap);
      padding: var(--hdr-pad-block) var(--space-6);
    }
    .brand {
      /* A step down from the 19px single-row wordmark, so the name sits
         with the résumé and theme buttons instead of towering over them. */
      --brand-size: 16px;
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
    }
    .actions {
      grid-column: 2;
      grid-row: 1;
      justify-self: start;
    }
    .site-header :global(.site-nav) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .header-sticky[data-nav-hidden] {
      --nav-collapse: calc(var(--nav-row-h, 0px) + var(--hdr-row-gap));
      pointer-events: none;
    }
    .header-sticky[data-nav-hidden] .brand,
    .header-sticky[data-nav-hidden] .actions {
      pointer-events: auto;
    }
    .header-sticky[data-nav-hidden] .site-header :global(.site-nav) {
      opacity: 0;
      transform: translateY(calc(-0.5 * var(--nav-collapse)));
      visibility: hidden;
      transition:
        opacity var(--dur-release) var(--ease-press),
        transform var(--dur-release) var(--ease-press),
        visibility 0s linear var(--dur-release);
    }
  }

  /* A mouse over the bar brings the nav back. Touch screens have no hover. */
  @media (max-width: 842px) and (hover: hover) and (pointer: fine) {
    .header-sticky[data-nav-hidden] .bar {
      pointer-events: auto;
    }
    .header-sticky[data-nav-hidden]:hover {
      --nav-collapse: 0px;
    }
    .header-sticky[data-nav-hidden]:hover .site-header :global(.site-nav) {
      opacity: 1;
      transform: none;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity var(--dur-release) var(--ease-press),
        transform var(--dur-release) var(--ease-press),
        visibility 0s linear 0s;
    }
  }

  @media (max-width: 842px) and (prefers-reduced-motion: reduce) {
    .header-sticky[data-nav-hidden] .site-header :global(.site-nav) {
      transition-delay: 0s;
    }
  }

  /* Phones: more space inside and outside the bar. Nav squares shrink only
     when they have to, so the rows keep that padding. The name scales to the
     room beside the résumé and theme buttons. */
  @media (max-width: 560px) {
    .header-wrap {
      padding-top: var(--space-3);
      padding-left: max(var(--space-4), env(safe-area-inset-left, 0px));
      padding-right: max(var(--space-4), env(safe-area-inset-right, 0px));
    }
    .site-header {
      /* Horizontal padding of one iso-hole: 0.75 * --iso-depth on each side. */
      --hole-x: calc(var(--iso-depth) * 1.5);
      --nav-gap: var(--space-2);
      --hdr-pad: var(--space-5);
      --hdr-gap: var(--space-3);
      /* "BAPTISTA-ALLAN" is about 8.84em wide. --actions-w is the measured
         width of the résumé and theme group; update it if that label changes. */
      --actions-w: 200px;
      --pill-pad-inline: 0.75rem;
      --iso-square-size: clamp(
        64px,
        (100cqi - 2 * var(--hdr-pad) - 3 * var(--hole-x) - 2 * var(--nav-gap)) / 3,
        88px
      );
      padding: var(--hdr-pad-block) var(--hdr-pad);
    }
    .brand {
      --brand-pad: 0px;
      --brand-size: clamp(
        10px,
        (100cqi - 2 * var(--hdr-pad) - var(--hdr-gap) - var(--actions-w)) / 8.84,
        16px
      );
    }
    .actions,
    .site-header :global(.site-nav) {
      gap: var(--nav-gap);
    }
  }

  /* The résumé icon comes off so the name can stay readable while the bar
     padding holds at the narrowest widths. */
  @media (max-width: 380px) {
    .site-header {
      --actions-w: 170px;
    }
    .site-header :global(.resume-link svg) {
      display: none;
    }
  }
</style>
