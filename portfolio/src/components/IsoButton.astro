---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'neutral' | 'azure' | 'scarlet' | 'tangerine' | 'gold';
type Size = 'pill' | 'square' | 'icon';

interface Props extends Omit<HTMLAttributes<'button'>, 'class'> {
  href?: string;
  download?: boolean | string;
  target?: string;
  rel?: string;
  variant?: Variant;
  size?: Size;
  /** Seated in the fully-pressed position (current page, active toggle). */
  pressed?: boolean;
  /** A dot under the hole while the button is seated. Uses the face in dark and the edge on the light bar. */
  mark?: boolean;
  /** Applied to the outer wrapper, for layout. */
  class?: string;
}

const {
  href,
  variant = 'neutral',
  size = 'pill',
  pressed = false,
  mark = false,
  class: className,
  type,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<span class:list={['iso-hole', className, { 'is-current': mark && pressed }]}>
  <Tag
    class:list={['iso-btn', `iso-btn--${size}`, `iso-btn--${variant}`, { 'is-pressed': pressed }]}
    href={href}
    type={href ? undefined : (type ?? 'button')}
    aria-current={href && pressed ? 'page' : undefined}
    aria-pressed={!href && pressed ? 'true' : undefined}
    {...rest}
  >
    <slot />
  </Tag>
  {mark && <span class="nav-mark" aria-hidden="true"></span>}
</span>

<style>
  /* Registered so it can transition; the face offset and the side-face
     length are both derived from it, which keeps the base fixed on every
     frame, including spring overshoot. */
  @property --press {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }

  /* The base sits at (0, --r) inside the hole for every tilt angle
     (--theta, written by iso-tilt.ts) and every --press value
     (0 = resting, 1 = seated). */
  .iso-hole {
    --r: var(--iso-depth);
    --tilt-range: var(--iso-tilt-range);
    --theta: 0rad;
    display: inline-block;
    vertical-align: middle;
    padding: 0 calc(var(--r) * 0.75) var(--r) calc(var(--r) * 0.75);
  }

  /* The extrusion. Its color fades on its own, so the tilt offsets stay instant. */
  .iso-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    color: var(--btn-edge);
    /* The edge color is animated from the splash. A transition here would
       restart from the original color when the button restyles. */
    box-shadow:
      calc(var(--dx) * 0.125) calc(var(--dy) * 0.125) 0 0 currentColor,
      calc(var(--dx) * 0.25) calc(var(--dy) * 0.25) 0 0 currentColor,
      calc(var(--dx) * 0.375) calc(var(--dy) * 0.375) 0 0 currentColor,
      calc(var(--dx) * 0.5) calc(var(--dy) * 0.5) 0 0 currentColor,
      calc(var(--dx) * 0.625) calc(var(--dy) * 0.625) 0 0 currentColor,
      calc(var(--dx) * 0.75) calc(var(--dy) * 0.75) 0 0 currentColor,
      calc(var(--dx) * 0.875) calc(var(--dy) * 0.875) 0 0 currentColor,
      var(--dx) var(--dy) 0 0 currentColor;
  }

  .iso-btn {
    --press: 0;
    /* the part of the depth still visible below the face */
    --dx: calc(var(--r) * sin(var(--theta)) * (1 - var(--press)));
    --dy: calc(var(--r) * cos(var(--theta)) * (1 - var(--press)));

    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    border: none;
    border-radius: var(--radius-md);
    background: var(--btn-bg);
    color: var(--btn-text);
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    position: relative;
    transform: translate(calc(-1 * var(--dx)), calc(var(--r) - var(--dy)));
    transition: --press var(--dur-release) var(--ease-spring);
  }

  @media (hover: hover) {
    .iso-hole:hover .iso-btn:not(:active):not(.is-pressed) {
      --press: 0.35;
      background: var(--btn-bg-hover);
    }
  }

  .iso-btn:active,
  .iso-btn.is-pressed {
    --press: 1;
    transition: --press var(--dur-press) var(--ease-press);
  }

  /* Keep the press timing. Face color eases on its own animation, not here,
     so a press cannot restart it. The extrusion shadow is not transitioned. */
  :global(html.flooding) .iso-btn {
    transition: --press var(--dur-release) var(--ease-spring);
  }

  :global(html.flooding) .iso-btn:active,
  :global(html.flooding) .iso-btn.is-pressed {
    transition: --press var(--dur-press) var(--ease-press);
  }

  .iso-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: var(--radius-md);
  }

  /* ---- sizes ---- */
  .iso-btn--pill {
    --pill-pad-block: 0.85rem;
    padding: var(--pill-pad-block) var(--pill-pad-inline, 1.5rem);
    /* The icon is taller than the text line, so text-only pills would
       otherwise sit shorter than pills that contain an icon. */
    min-height: calc(var(--iso-icon) + var(--pill-pad-block) * 2);
  }

  .iso-btn--square {
    flex-direction: column;
    gap: 0.3rem;
    width: var(--iso-square-size, 88px);
    height: var(--iso-square-size, 88px);
    padding: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .iso-btn--icon {
    width: 48px;
    height: 48px;
    padding: 0;
  }

  .iso-btn :global(svg) {
    width: var(--iso-icon);
    height: var(--iso-icon);
    flex-shrink: 0;
  }
  .iso-btn--square :global(svg) {
    width: 24px;
    height: 24px;
  }

  /* ---- variants ---- */
  .iso-btn--neutral {
    --btn-bg: var(--neutral);
    --btn-bg-hover: var(--neutral-hover);
    --btn-edge: var(--neutral-edge);
    --btn-text: var(--neutral-ink);
  }
  .iso-btn--azure {
    --btn-bg: var(--azure);
    --btn-bg-hover: var(--azure-hover);
    --btn-edge: var(--azure-edge);
    --btn-text: var(--azure-label);
  }
  .iso-btn--scarlet {
    --btn-bg: var(--scarlet);
    --btn-bg-hover: var(--scarlet-hover);
    --btn-edge: var(--scarlet-edge);
    --btn-text: var(--scarlet-label);
  }
  .iso-btn--tangerine {
    --btn-bg: var(--tangerine);
    --btn-bg-hover: var(--tangerine-hover);
    --btn-edge: var(--tangerine-edge);
    --btn-text: var(--tangerine-label);
  }
  .iso-btn--gold {
    --btn-bg: var(--gold);
    --btn-bg-hover: var(--gold-hover);
    --btn-edge: var(--gold-edge);
    --btn-text: var(--gold-label);
  }

  /* Centered in the header's padding under the hole. The hole does not
     grow, so the dot never changes the button's layout. Shown and hidden
     with the page swap, not with the button's press. */
  .nav-mark {
    --mark-size: 6px;
    position: absolute;
    left: 50%;
    bottom: calc((var(--hdr-pad-block, var(--space-5)) + var(--mark-size)) / -2);
    width: var(--mark-size);
    height: var(--mark-size);
    border-radius: var(--radius-pill);
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
  }
  .iso-hole:has(.nav-mark) {
    position: relative;
  }
  .iso-hole.is-current > .nav-mark {
    opacity: 1;
  }
  .iso-hole:has(.iso-btn--neutral) > .nav-mark { background: var(--neutral-mark); }
  .iso-hole:has(.iso-btn--azure) > .nav-mark { background: var(--azure-mark); }
  .iso-hole:has(.iso-btn--scarlet) > .nav-mark { background: var(--scarlet-mark); }
  .iso-hole:has(.iso-btn--tangerine) > .nav-mark { background: var(--tangerine-mark); }
  .iso-hole:has(.iso-btn--gold) > .nav-mark { background: var(--gold-mark); }
</style>

<script>
  import '../scripts/iso-tilt';
</script>
